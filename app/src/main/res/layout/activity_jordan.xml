<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ForceActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/nikeTitle"
        android:text="Nike Sneakers"
        android:textSize="36sp"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="@color/dark"
        android:layout_centerHorizontal="true"/>

    <ImageView
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:id="@+id/nikeImage"
        android:layout_below="@id/nikeTitle"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:src="@drawable/nikecheck"/>

    <LinearLayout
        android:layout_width="500dp"
        android:layout_height="500dp"
        android:id="@+id/row"
        android:orientation="horizontal"
        android:layout_below="@id/nikeImage"
        android:layout_centerHorizontal="false"
        android:layout_centerVertical="true"
        android:padding="10dp">

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:id="@+id/nikeCard1"
            android:layout_margin="10dp"
            android:layout_weight="1"
            app:cardElevation="5dp"
            app:cardCornerRadius="20dp">

            <TextView
                android:id="@+id/nike1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Air Jordan"
                android:textColor="@color/main"
                android:layout_marginLeft="105dp"
                android:textSize="30sp" />

            <ImageView
                android:id="@+id/nikeImage1"
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:layout_marginTop="40dp"
                android:layout_marginLeft="95dp"
                android:src="@drawable/airjordan" />

            <TextView
                android:id="@+id/nikeInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="200dp"
                android:fontFamily="@font/poppins"
                android:text="          The first Air Jordan was produced for use by Michael Jordan in November 1984. They were designed by Peter B. Moore, and released during Jordan's sophomore season with the Chicago Bulls. "
                android:textColor="@color/black"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:textSize="15sp"
                android:justificationMode="inter_word"
                android:lineSpacingExtra="8dp"
                android:lineSpacingMultiplier="1.2" />

            <Button
                android:id="@+id/tryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="395dp"
                android:layout_marginLeft="250dp"
                android:text="Try-On"
                android:backgroundTint="@color/main" />

        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <ImageView
        android:id="@+id/arrowLeft"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="660dp"
        android:layout_marginLeft="65dp"
        android:alpha="0.8"
        android:src="@drawable/arrowleft" />

    <ImageView
        android:id="@+id/arrowRight"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginTop="660dp"
        android:layout_marginLeft="310dp"
        android:alpha="0.8"
        android:src="@drawable/arrowright" />

    <ImageView
        android:id="@+id/numList"
        android:layout_width="100dp"
        android:layout_height="60dp"
        android:layout_marginTop="650dp"
        android:layout_marginLeft="155dp"
        android:alpha="0.9"
        android:src="@drawable/second" />

    <ImageView
        android:id="@+id/back"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="20dp"
        android:alpha="0.9"
        android:src="@drawable/back" />

</RelativeLayout>